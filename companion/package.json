{
  "name": "orion-companion",
  "version": "0.13.0",
  "description": "Desktop companion app for the Orion PDA V3",
  "homepage": "https://orionpda.org",
  "main": "./out/main/index.js",
  "author": {
    "name": "Orion project",
    "email": "info@mvlabs.org"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-calendario.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:icons": "node scripts/build-mac-icon.mjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "build:calendario": "node scripts/build-calendario.mjs",
    "prova:cal": "tsx scripts/prova-cal.ts /tmp/prova_ts.cal && ../prove_pc/cal_file --generico /tmp/prova_ts.cal && tsx scripts/prova-ics.ts /tmp/prova_ics.cal && ../prove_pc/cal_file --generico /tmp/prova_ics.cal",
    "prova": "npm run prova:cal && tsx scripts/prova-ble.ts",
    "emu:copia": "node -e \"require('fs').copyFileSync('../../SDK/emulator/web/dist/orion-emu.mjs','src/renderer/src/emu/orion-emu.mjs')\"",
    "wiki": "tsx scripts/wiki.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "any-ascii": "^0.3.3",
    "entities": "^9.0.0",
    "fzstd": "^0.1.1",
    "ical.js": "^2.2.1",
    "jimp": "^0.22.12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "marked": "^12.0.0",
    "node-html-parser": "^6.1.13",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
